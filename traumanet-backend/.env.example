# Copiar a .env (excluido de Git) y reemplazar los valores. NO guardar secretos reales aquí.

# Versiones fijadas (verificar tags en Docker Hub antes de cambiarlas)
POSTGRES_VERSION=16.6
MONGO_VERSION=7.0.15
NEO4J_VERSION=5.26.0

# PostgreSQL (relacional)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=traumanet
POSTGRES_USER=traumanet
POSTGRES_PASSWORD=

# MongoDB (documental)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=traumanet
MONGO_PASSWORD=
MONGO_DB=traumanet

# Neo4j (grafo)
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Aplicación y autenticación JWT (D-0005 / Q-05)
RESERVA_TTL_MIN=15
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
FRONTEND_URL=http://localhost:3000
